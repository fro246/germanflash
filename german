<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wörter – German practice</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #eef1f4; --panel: #ffffff; --ink: #17232f; --muted: #64727f; --line: #d5dbe1;
    --der: #2f6db5; --die: #c6414c; --das: #3a8a58;
    --ok: #2f8a55; --bad: #c6414c; --ok-bg: #e4f4ea; --bad-bg: #fbe6e8;
    --display: "Bricolage Grotesque", "Trebuchet MS", system-ui, sans-serif;
    --body: "Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10171e; --panel: #19232d; --ink: #e8edf1; --muted: #93a1ae; --line: #2c3a47;
      --der: #6ea6e8; --die: #ee7b85; --das: #6cc48b;
      --ok: #6cc48b; --bad: #ee7b85; --ok-bg: #1c3a29; --bad-bg: #402328;
    }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body { background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 16px; line-height: 1.5; padding: 20px 16px 60px; }
  main { max-width: 640px; margin: 0 auto; }
  header { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
  h1 { font-family: var(--display); font-weight: 800; font-size: 34px; letter-spacing: -0.02em; margin: 0; }
  .meta { color: var(--muted); font-size: 14px; display: flex; gap: 12px; }
  .badge.bad { color: var(--bad); } .badge.ok { color: var(--ok); }

  nav { display: flex; gap: 4px; border-bottom: 2px solid var(--line); margin-bottom: 20px; overflow-x: auto; }
  nav button { font: inherit; font-weight: 600; background: none; border: 0; color: var(--muted); padding: 10px 14px; cursor: pointer;
    border-bottom: 3px solid transparent; margin-bottom: -2px; white-space: nowrap; }
  nav button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--ink); }
  button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 3px solid var(--der); outline-offset: 2px; }
  section[hidden], .overlay[hidden], .nouns[hidden], .verbs[hidden], .bar[hidden] { display: none; }

  .bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; align-items: center; }
  .bar .lbl { font-size: 13px; color: var(--muted); min-width: 62px; }
  .chip { font: inherit; font-size: 14px; padding: 5px 13px; border-radius: 999px; border: 1.5px solid var(--line);
    background: var(--panel); color: var(--ink); cursor: pointer; }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .score { color: var(--muted); font-size: 14px; margin: 4px 0 12px; min-height: 21px; }

  .card { background: var(--panel); border: 1.5px solid var(--line); border-radius: 14px; padding: 24px 22px; }
  .card.der { border-top: 6px solid var(--der); } .card.die { border-top: 6px solid var(--die); } .card.das { border-top: 6px solid var(--das); }
  .prompt { font-family: var(--display); font-weight: 700; font-size: 32px; line-height: 1.15; margin: 4px 0 2px; }
  .art.der { color: var(--der); } .art.die { color: var(--die); } .art.das { color: var(--das); }
  .tag { display: inline-block; font-size: 13px; color: var(--muted); margin-bottom: 2px; }
  .hint { color: var(--muted); font-size: 14px; margin: 0 0 18px; }
  .fields { display: grid; gap: 12px; margin-bottom: 14px; }
  .field label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 3px; }
  input[type="text"], input[type="password"], select { width: 100%; font: inherit; font-size: 18px; padding: 10px 12px; border-radius: 9px;
    border: 1.5px solid var(--line); background: var(--bg); color: var(--ink); }
  input.ok { border-color: var(--ok); background: var(--ok-bg); }
  input.bad { border-color: var(--bad); background: var(--bad-bg); }
  .answer { font-size: 14px; color: var(--bad); margin-top: 3px; font-weight: 600; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 460px) { .grid2 { grid-template-columns: 1fr; } }
  .keys { display: flex; gap: 6px; margin-bottom: 16px; }
  .keys button { font: inherit; font-size: 17px; min-width: 42px; padding: 6px 0; border-radius: 8px; border: 1.5px solid var(--line);
    background: var(--panel); color: var(--ink); cursor: pointer; }
  .btn { font: inherit; font-weight: 600; padding: 11px 20px; border-radius: 10px; cursor: pointer; border: 1.5px solid var(--ink);
    background: var(--ink); color: var(--bg); }
  .btn.ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .btn.danger { background: transparent; color: var(--bad); border-color: var(--bad); }
  .btn.small { padding: 5px 11px; font-size: 14px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .msg { font-weight: 600; margin: 0 0 8px; }
  .msg.ok { color: var(--ok); } .msg.bad { color: var(--bad); }
  .note { color: var(--muted); font-size: 14px; margin: 0 0 12px; }
  .empty { text-align: center; color: var(--muted); padding: 36px 10px; }

  .list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
  .list li { background: var(--panel); border: 1.5px solid var(--line); border-left-width: 6px; border-radius: 10px; padding: 10px 12px;
    display: flex; gap: 10px; align-items: center; justify-content: space-between; }
  .list li.der { border-left-color: var(--der); } .list li.die { border-left-color: var(--die); }
  .list li.das { border-left-color: var(--das); } .list li.verb { border-left-color: var(--ink); }
  .list .de { font-weight: 600; } .list .en { color: var(--muted); font-size: 14px; font-weight: 400; }
  .list .extra { color: var(--muted); font-size: 13px; }
  .lv { font-size: 12px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 0 7px; margin-left: 8px; font-weight: 500; }
  .form-title { font-family: var(--display); font-weight: 700; font-size: 22px; margin: 0 0 14px; }
  h3 { font-family: var(--display); font-size: 18px; margin: 22px 0 8px; }
  details { margin: 6px 0 14px; } summary { cursor: pointer; font-weight: 600; }
  details ol { padding-left: 20px; margin: 8px 0; } details li { margin-bottom: 4px; }
  hr { border: 0; border-top: 1.5px solid var(--line); margin: 20px 0; }
  .toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); background: var(--ink); color: var(--bg);
    padding: 9px 16px; border-radius: 999px; font-size: 14px; opacity: 0; pointer-events: none; transition: opacity .2s; max-width: 90vw; text-align: center; }
  .toast.show { opacity: 1; }
  .overlay { position: fixed; inset: 0; background: rgba(10,16,22,.55); display: grid; place-items: center; padding: 20px; z-index: 10; }
  .dialog { background: var(--panel); border-radius: 14px; padding: 22px; max-width: 380px; width: 100%; }
  .dialog p { margin: 0 0 16px; }
  @media (prefers-reduced-motion: reduce) { .toast { transition: none; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>Wörter</h1>
    <div class="meta"><span id="syncBadge" class="badge"></span><span id="count"></span></div>
  </header>

  <nav role="tablist" aria-label="Sections">
    <button role="tab" data-tab="practice" aria-selected="true">Practice</button>
    <button role="tab" data-tab="add" aria-selected="false">Add word</button>
    <button role="tab" data-tab="list" aria-selected="false">My words</button>
    <button role="tab" data-tab="backup" aria-selected="false">Save &amp; sync</button>
  </nav>

  <!-- PRACTICE -->
  <section id="tab-practice">
    <div class="bar" id="dirBar">
      <span class="lbl">Direction</span>
      <button class="chip" data-d="en2de" aria-pressed="true">English → German</button>
      <button class="chip" data-d="de2en" aria-pressed="false">German → English</button>
      <button class="chip" data-d="mixed" aria-pressed="false">Mixed</button>
    </div>
    <div class="bar" id="levelBar" hidden></div>
    <div class="bar" id="filters">
      <span class="lbl">Words</span>
      <button class="chip" data-f="all" aria-pressed="true">All</button>
      <button class="chip" data-f="noun" aria-pressed="false">Nouns</button>
      <button class="chip" data-f="verb" aria-pressed="false">Verbs</button>
      <button class="chip" data-f="other" aria-pressed="false">Other</button>
      <button class="chip" id="missedChip" aria-pressed="false">Missed only</button>
    </div>
    <div class="score" id="score"></div>
    <div id="practiceArea"></div>
  </section>

  <!-- ADD / EDIT -->
  <section id="tab-add" hidden>
    <div class="card" id="addForm">
      <h2 class="form-title" id="formTitle">Add a word</h2>
      <div class="fields">
        <div class="field">
          <label for="fType">Type of word</label>
          <select id="fType">
            <option value="noun">Noun</option>
            <option value="verb">Verb</option>
            <option value="other">Other (adjective, phrase, adverb…)</option>
          </select>
        </div>
        <div class="field"><label for="fLevel">Level (where you learned it)</label><select id="fLevel"></select></div>
        <div class="field"><label for="fEn">English meaning</label><input type="text" id="fEn" placeholder="house" autocomplete="off"></div>
        <div class="field"><label for="fDe" id="fDeLabel">German word</label><input type="text" id="fDe" placeholder="Haus" autocomplete="off"></div>

        <div class="nouns fields">
          <div class="grid2">
            <div class="field"><label for="fArt">Article</label>
              <select id="fArt"><option>der</option><option>die</option><option>das</option></select></div>
            <div class="field"><label for="fPlural">Plural (leave empty if none)</label>
              <input type="text" id="fPlural" placeholder="Häuser" autocomplete="off"></div>
          </div>
        </div>

        <div class="verbs fields" hidden>
          <div class="row">
            <button type="button" class="btn ghost small" id="autoFill">Auto-fill regular verb</button>
            <span class="note" style="margin:0">Always check irregular verbs by hand.</span>
          </div>
          <div class="grid2">
            <div class="field"><label for="v_ich">ich</label><input type="text" id="v_ich" autocomplete="off"></div>
            <div class="field"><label for="v_du">du</label><input type="text" id="v_du" autocomplete="off"></div>
            <div class="field"><label for="v_er">er / sie / es</label><input type="text" id="v_er" autocomplete="off"></div>
            <div class="field"><label for="v_wir">wir</label><input type="text" id="v_wir" autocomplete="off"></div>
            <div class="field"><label for="v_ihr">ihr</label><input type="text" id="v_ihr" autocomplete="off"></div>
            <div class="field"><label for="v_sie">sie / Sie</label><input type="text" id="v_sie" autocomplete="off"></div>
          </div>
        </div>
      </div>
      <div class="keys" id="addKeys" aria-label="Special characters">
        <button type="button">ä</button><button type="button">ö</button><button type="button">ü</button><button type="button">ß</button>
      </div>
      <p class="note">To accept more than one answer, separate them with a slash, like “to make / to do” or “Bänke/Banken”.</p>
      <div class="row">
        <button class="btn" type="button" id="saveBtn">Save word</button>
        <button class="btn ghost" type="button" id="cancelEdit" hidden>Cancel</button>
      </div>
    </div>
  </section>

  <!-- LIST -->
  <section id="tab-list" hidden>
    <div class="row">
      <input type="text" id="search" placeholder="Search words…" style="flex:1; min-width:160px" aria-label="Search words" autocomplete="off">
      <select id="listFilter" style="width:auto" aria-label="Filter by type">
        <option value="all">All types</option><option value="noun">Nouns</option>
        <option value="verb">Verbs</option><option value="other">Other</option>
      </select>
      <select id="listLevel" style="width:auto" aria-label="Filter by level"></select>
    </div>
    <div class="row" style="margin-top:10px">
      <span class="note" style="margin:0">Set the level of all words shown:</span>
      <select id="bulkLevel" style="width:auto; font-size:15px; padding:6px 10px" aria-label="Level to apply"></select>
      <button class="btn ghost small" id="bulkApply">Apply</button>
    </div>
    <ul class="list" id="wordList"></ul>
  </section>

  <!-- SAVE & SYNC -->
  <section id="tab-backup" hidden>
    <div class="card">
      <h2 class="form-title">Save to GitHub</h2>
      <p class="note">Your words are always saved in this browser. Connect your GitHub repository and they are also saved as a file there, so they survive clearing your browser and work on your phone and laptop.</p>
      <div class="fields">
        <div class="grid2">
          <div class="field"><label for="sOwner">GitHub username</label><input type="text" id="sOwner" autocomplete="off"></div>
          <div class="field"><label for="sRepo">Repository name</label><input type="text" id="sRepo" autocomplete="off"></div>
          <div class="field"><label for="sBranch">Branch</label><input type="text" id="sBranch" value="main" autocomplete="off"></div>
          <div class="field"><label for="sPath">Data file</label><input type="text" id="sPath" value="woerter-data.json" autocomplete="off"></div>
        </div>
        <div class="field"><label for="sToken">Access token (needed to save; leave empty to only load)</label>
          <input type="password" id="sToken" autocomplete="off" placeholder="github_pat_…"></div>
      </div>
      <div class="row">
        <button class="btn" id="connectBtn">Connect &amp; sync</button>
        <button class="btn ghost" id="syncBtn">Sync now</button>
        <button class="btn ghost" id="disconnectBtn">Disconnect</button>
      </div>
      <p class="note" id="syncStatus" style="margin-top:12px"></p>
      <details>
        <summary>How do I get a token?</summary>
        <ol>
          <li>On GitHub, open Settings → Developer settings → Personal access tokens → Fine-grained tokens → Generate new token.</li>
          <li>Under “Repository access”, choose “Only select repositories” and pick this site’s repository.</li>
          <li>Under “Permissions → Repository permissions”, set <b>Contents</b> to “Read and write”.</li>
          <li>Generate, copy the token and paste it above. It is stored only in this browser. On each new device, paste it again.</li>
        </ol>
        <p class="note">Each save becomes a commit of <code>woerter-data.json</code> in your repo. If you use the site on two devices, the most recent change wins.</p>
      </details>

      <hr>
      <h3 style="margin-top:0">File backup</h3>
      <div class="row" style="margin-bottom:8px">
        <button class="btn ghost" id="exportBtn">Download backup</button>
        <label class="btn ghost" style="cursor:pointer">Restore from file
          <input type="file" id="importFile" accept="application/json" hidden></label>
      </div>
      <p class="note">Restoring adds words from the file to what you already have. Duplicates are skipped.</p>
      <hr>
      <div class="row">
        <button class="btn ghost" id="resetProgress">Reset practice scores</button>
        <button class="btn danger" id="deleteAll">Delete all words</button>
      </div>
    </div>
  </section>
</main>

<div class="overlay" id="dlg" hidden>
  <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dlgMsg">
    <p id="dlgMsg"></p>
    <div class="row"><button class="btn danger" id="dlgYes">Yes</button><button class="btn ghost" id="dlgNo">Cancel</button></div>
  </div>
</div>
<div class="toast" id="toast" role="status"></div>

<script>
(function () {
  "use strict";

  /* ---------- Starter words (edit freely) ---------- */
  var SEED = [
    { type: "noun", en: "house", de: "Haus", article: "das", plural: "Häuser" },
    { type: "noun", en: "woman", de: "Frau", article: "die", plural: "Frauen" },
    { type: "noun", en: "man", de: "Mann", article: "der", plural: "Männer" },
    { type: "noun", en: "book", de: "Buch", article: "das", plural: "Bücher" },
    { type: "verb", en: "to make / to do", de: "machen",
      forms: { ich: "mache", du: "machst", er: "macht", wir: "machen", ihr: "macht", sie: "machen" } },
    { type: "verb", en: "to eat", de: "essen",
      forms: { ich: "esse", du: "isst", er: "isst", wir: "essen", ihr: "esst", sie: "essen" } },
    { type: "verb", en: "to speak", de: "sprechen",
      forms: { ich: "spreche", du: "sprichst", er: "spricht", wir: "sprechen", ihr: "sprecht", sie: "sprechen" } },
    { type: "other", en: "thank you", de: "danke" },
    { type: "other", en: "good", de: "gut" }
  ];
  SEED.forEach(function (w) { w.level = "A1.1"; });

  var LEVELS = ["A1.1","A1.2","A2.1","A2.2","B1.1","B1.2","B2.1","B2.2","C1.1","C1.2","C2.1","C2.2"];
  var KEY = "woerter-v1", KEY_CFG = "woerter-sync", KEY_SET = "woerter-settings";
  var BOX_WEIGHT = [10, 5, 3, 1.5, 0.6], UNSEEN_WEIGHT = 4;
  var words = [], updatedAt = 0;
  var current = null, checked = false, lastId = null, cardCount = 0, retry = [];
  var filter = "all", missedOnly = false, direction = "en2de", levelSel = [], lastLevel = "A1.1";
  var stats = { right: 0, total: 0 };
  var editingId = null, lastInput = null;
  var cfg = { owner: "", repo: "", branch: "main", path: "woerter-data.json", token: "", lastSync: 0 };
  var sha = null, dirty = false, pushing = false, pushTimer = null, pushDue = 0;

  /* ---------- Helpers ---------- */
  function $(id) { return document.getElementById(id); }
  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
  function clean(k, v) { return k === "_dir" ? undefined : v; }
  function esc(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }
  function toast(t) {
    var el = $("toast"); el.textContent = t; el.classList.add("show");
    clearTimeout(toast.t); toast.t = setTimeout(function () { el.classList.remove("show"); }, 2600);
  }
  function ask(msg, yesLabel, cb) {
    $("dlgMsg").textContent = msg; $("dlgYes").textContent = yesLabel; $("dlg").hidden = false; $("dlgNo").focus();
    function close() { $("dlg").hidden = true; }
    $("dlgYes").onclick = function () { close(); cb(); };
    $("dlgNo").onclick = close;
  }
  // Lenient comparison: ignores case; accepts ae/oe/ue/ss for ä/ö/ü/ß
  function norm(s) {
    return String(s || "").trim().toLowerCase().replace(/\s+/g, " ")
      .replace(/ä/g, "ae").replace(/ö/g, "oe").replace(/ü/g, "ue").replace(/ß/g, "ss");
  }
  function matches(input, answer) {
    return String(answer || "").split("/").some(function (o) { return norm(o) === norm(input); });
  }
  function enClean(s) {
    return norm(String(s).replace(/\(.*?\)/g, "")).replace(/^(to|the|a|an) /, "").trim();
  }
  function enMatches(input, answer) {
    return String(answer || "").split(/[\/,;]/).some(function (o) { return enClean(o) === enClean(input); });
  }
  function articleClass(w) { return w.type === "noun" ? w.article : w.type; }

  /* ---------- Storage ---------- */
  function load() {
    try {
      var raw = localStorage.getItem(KEY);
      if (raw) {
        var d = JSON.parse(raw);
        if (Array.isArray(d)) { words = d; updatedAt = 1; } else { words = d.words || []; updatedAt = d.updatedAt || 0; }
      } else {
        words = SEED.map(function (w) { return Object.assign({ id: uid(), hits: 0, misses: 0 }, w); });
        updatedAt = 0; persist();
      }
    } catch (e) {
      words = SEED.map(function (w) { return Object.assign({ id: uid(), hits: 0, misses: 0 }, w); });
    }
    try { var c = JSON.parse(localStorage.getItem(KEY_CFG)); if (c) cfg = Object.assign(cfg, c); } catch (e) {}
    try {
      var s = JSON.parse(localStorage.getItem(KEY_SET));
      if (s) { if (s.direction) direction = s.direction; if (Array.isArray(s.levels)) levelSel = s.levels; if (s.lastLevel != null) lastLevel = s.lastLevel; }
    } catch (e) {}
  }
  function persist() {
    try { localStorage.setItem(KEY, JSON.stringify({ updatedAt: updatedAt, words: words }, clean)); return true; }
    catch (e) { return false; }
  }
  function saveSettings() {
    try { localStorage.setItem(KEY_SET, JSON.stringify({ direction: direction, levels: levelSel, lastLevel: lastLevel })); } catch (e) {}
  }
  function saveCfg() { try { localStorage.setItem(KEY_CFG, JSON.stringify(cfg)); } catch (e) {} }
  // kind: "edit" (push soon) or "progress" (push later)
  function commit(kind) {
    updatedAt = Date.now();
    if (!persist()) toast("Couldn't save in this browser. Is storage blocked?");
    schedulePush(kind === "progress" ? 45000 : 3000);
  }

  /* ---------- Tabs ---------- */
  var tabs = ["practice", "add", "list", "backup"];
  function showTab(name) {
    tabs.forEach(function (t) { $("tab-" + t).hidden = t !== name; });
    document.querySelectorAll("nav button").forEach(function (b) { b.setAttribute("aria-selected", b.dataset.tab === name ? "true" : "false"); });
    if (name === "practice") nextCard(true);
    if (name === "list") renderList();
    if (name === "add" && editingId === null) resetForm();
    if (name === "backup") fillSyncForm();
  }
  document.querySelectorAll("nav button").forEach(function (b) {
    b.addEventListener("click", function () { if (b.dataset.tab !== "add") cancelEdit(); showTab(b.dataset.tab); });
  });

  /* ---------- Practice ---------- */
  function streakOf(w) { return w.streak != null ? w.streak : ((w.box || 0) >= 2 ? 3 : 0); }
  // A word counts as "missed" until you get it right 3 times in a row
  function isMissed(w) { return (w.misses || 0) > 0 && streakOf(w) < 3; }
  function levelOk(w) { return !levelSel.length || levelSel.indexOf(w.level || "") > -1; }
  function pool() {
    return words.filter(function (w) {
      return levelOk(w) && (filter === "all" || w.type === filter) && (!missedOnly || isMissed(w));
    });
  }
  function weightOf(w) { if (missedOnly) return 1; return w.box == null ? UNSEEN_WEIGHT : BOX_WEIGHT[w.box]; }
  function pickWord() {
    var p = pool();
    if (!p.length) return null;
    // A missed word comes back after about 3 cards
    for (var i = 0; i < retry.length; i++) {
      var r = retry[i];
      if (r.due <= cardCount && r.id !== lastId) {
