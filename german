        cfg.lastSync = Date.now(); saveCfg();
      } else if (cfg.token) {
        await push(false); setStatus("Created " + cfg.path + " in your repository and saved your words.");
      } else {
        setStatus("No data file in the repository yet. Add a token to create it.");
      }
      dirty = false;
    } catch (e) { setStatus("Couldn't sync: " + e.message, "bad"); }
    setBadgeOnly();
  }
  function setBadgeOnly() {
    var b = $("syncBadge");
    if (b.className.indexOf("bad") === -1) b.textContent = connected() && cfg.lastSync ? "Saved to GitHub" : "";
  }
  function fillSyncForm() {
    var host = location.hostname, owner = "", repo = "";
    if (/\.github\.io$/.test(host)) { owner = host.split(".")[0]; repo = location.pathname.split("/")[1] || host; }
    $("sOwner").value = cfg.owner || owner; $("sRepo").value = cfg.repo || repo;
    $("sBranch").value = cfg.branch; $("sPath").value = cfg.path; $("sToken").value = cfg.token;
    if (!$("syncStatus").textContent) setStatus(connected() ? "Connected to " + cfg.owner + "/" + cfg.repo + "." : "Not connected.");
  }
  $("connectBtn").addEventListener("click", function () {
    cfg.owner = $("sOwner").value.trim(); cfg.repo = $("sRepo").value.trim();
    cfg.branch = $("sBranch").value.trim() || "main"; cfg.path = $("sPath").value.trim() || "woerter-data.json";
    cfg.token = $("sToken").value.trim(); sha = null; saveCfg(); syncNow(true);
  });
  $("syncBtn").addEventListener("click", function () { syncNow(false); });
  $("disconnectBtn").addEventListener("click", function () {
    cfg.owner = ""; cfg.repo = ""; cfg.token = ""; cfg.lastSync = 0; saveCfg(); sha = null; dirty = false;
    $("sToken").value = ""; setStatus("Disconnected. Words stay in this browser."); $("syncBadge").textContent = "";
  });
  document.addEventListener("visibilitychange", function () {
    if (!connected()) return;
    if (document.visibilityState === "hidden" && dirty && cfg.token && !pushing) {
      clearTimeout(pushTimer); pushTimer = null; dirty = false; push(true).catch(function () { dirty = true; });
    } else if (document.visibilityState === "visible" && !dirty && !pushing) { syncNow(false); }
  });

  /* ---------- Levels ---------- */
  function presentLevels() {
    var seen = {}; words.forEach(function (w) { seen[w.level || ""] = true; });
    var out = LEVELS.filter(function (l) { return seen[l]; });
    if (seen[""] && out.length) out.push("");
    return out;
  }
  function fillLevelSelects() {
    $("fLevel").innerHTML = '<option value="">No level</option>' + LEVELS.map(function (l) { return "<option>" + l + "</option>"; }).join("");
    $("bulkLevel").innerHTML = LEVELS.map(function (l) { return "<option>" + l + "</option>"; }).join("");
    $("fLevel").value = lastLevel;
  }
  function renderLevelChips() {
    var bar = $("levelBar"), lv = presentLevels();
    levelSel = levelSel.filter(function (l) { return lv.indexOf(l) > -1; });
    bar.hidden = false;
    if (!lv.length) {
      bar.innerHTML = '<span class="lbl">Level</span><span class="note" style="margin:0">No levels yet. Set one in Add word, or use “Set the level of all words shown” in My words.</span>';
      return;
    }
    var html = '<span class="lbl">Level</span><button class="chip" data-l="__all" aria-pressed="' + (levelSel.length === 0) + '">All</button>';
    lv.forEach(function (l) {
      html += '<button class="chip" data-l="' + esc(l || "__none") + '" aria-pressed="' + (levelSel.indexOf(l) > -1) + '">' + (l || "No level") + "</button>";
    });
    bar.innerHTML = html;
  }
  $("levelBar").addEventListener("click", function (e) {
    var b = e.target.closest(".chip"); if (!b) return;
    if (b.dataset.l === "__all") levelSel = [];
    else {
      var v = b.dataset.l === "__none" ? "" : b.dataset.l, i = levelSel.indexOf(v);
      if (i > -1) levelSel.splice(i, 1); else levelSel.push(v);
    }
    saveSettings(); renderLevelChips(); current = null; checked = false; nextCard(false);
  });
  $("bulkApply").addEventListener("click", function () {
    var shown = listWords(), lvl = $("bulkLevel").value;
    if (!shown.length) { toast("No words shown to update."); return; }
    ask("Set level " + lvl + " for the " + shown.length + " word" + (shown.length === 1 ? "" : "s") + " shown?", "Apply", function () {
      shown.forEach(function (w) { w.level = lvl; });
      commit("edit"); updateCount(); renderList(); toast("Level updated");
    });
  });

  function updateCount() {
    var n = words.length; $("count").textContent = n + " word" + (n === 1 ? "" : "s");
    renderLevelChips();
  }

  /* ---------- Start ---------- */
  load(); fillLevelSelects(); updateCount(); typeChanged(); markDirChips(); nextCard(false);
  if (connected()) syncNow(false);
})();
</script>
</body>
</html>
