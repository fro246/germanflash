  }
  function timeStr() { return new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }); }

  async function pull() {
    var res = await fetch(apiUrl() + "?ref=" + encodeURIComponent(cfg.branch), { headers: headers(), cache: "no-store" });
    if (res.status === 404) return null;
