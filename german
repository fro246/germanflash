  function errText(res) {
    if (res.status === 401 || res.status === 403) return "GitHub rejected the token. Check it has Contents: Read and write for this repository.";
    if (res.status === 404) return "Repository or branch not found (or the token can't see it).";
    return "GitHub returned error " + res.status + ".";
  }
  function setStatus(text, kind) {
