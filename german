    var payload = JSON.stringify({ app: "woerter", updatedAt: updatedAt, words: words }, clean, 1);
    async function attempt() {
      var body = { message: "Update German words", content: b64enc(payload), branch: cfg.branch };
      if (sha) body.sha = sha;
