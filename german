    var j = await res.json();
    var d = JSON.parse(b64dec(j.content));
    return { sha: j.sha, updatedAt: Array.isArray(d) ? 1 : (d.updatedAt || 0), words: Array.isArray(d) ? d : (d.words || []) };
  }
